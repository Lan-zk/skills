# GitHub Token (optional, raises README API rate limit from 60 → 5000 req/hr)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# LLM Translation Configuration (SiliconFlow or OpenAI-compatible API)
# Required for translation feature
LLM_API_KEY=your-api-key-here

# Optional: API base URL (defaults to SiliconFlow)
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434/v1  # Ollama local

# Optional: Model name (defaults to Qwen/Qwen2.5-72B-Instruct)
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=deepseek-chat

# Optional: Playwright browser channel (defaults to system Chrome)
# PLAYWRIGHT_CHANNEL=skip  # forces bundled Chromium (requires playwright install)
